# Homepage Editor - settings. SPDX-License-Identifier: MIT
#
# Easy way: run ./setup.sh, it asks for these and writes .env for you.
# By hand: copy this file to .env (cp .env.example .env) and change the values.
# Only the two settings marked REQUIRED must be filled in; the rest have working defaults.
# Keep the single quotes: they keep characters like $ and # in a password as they are.

# ---- REQUIRED --------------------------------------------------------------
# Homepage's config folder on this server (the folder with services.yaml and settings.yaml).
# Find it: docker inspect homepage --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}'
HOMEPAGE_CONFIG='/opt/homepage/config'

# Password for the login page (at least 8 characters). Not needed when AUTH_MODE='off'.
EDITOR_PASSWORD=''

# ---- Owner of Homepage's config files -------------------------------------
# The editor runs as this user so it can save Homepage's files. Find them: ls -ln /opt/homepage/config
PUID='1000'
PGID='1000'

# ---- Login -----------------------------------------------------------------
EDITOR_USER='admin'
# login = login page (recommended). off = no login at all: ONLY when something else protects
# the editor (Authelia, Authentik, an NPM access list, a VPN...).
AUTH_MODE='login'

# ---- Address and port ------------------------------------------------------
# Port of the editor page on this server.
EDITOR_PORT='5005'
# Where the "Open Homepage" button goes: protocol, address and port (port may be empty).
HOMEPAGE_PROTOCOL='http'
HOMEPAGE_HOST='192.168.1.10'
HOMEPAGE_PORT='3000'

# ---- Folders of the editor (default: next to docker-compose.yml) ----------
# They are created and given to PUID:PGID automatically when the editor starts.
#BACKUP_PATH='/opt/homepage-editor/backups'
#DATA_PATH='/opt/homepage-editor/data'
# How many dated backups to keep (0 = keep all).
BACKUP_KEEP='100'

# ---- Other -----------------------------------------------------------------
TZ='UTC'                            # time zone for backup dates, e.g. Europe/Amsterdam
STACK_NAME='homepage-editor'        # name of the stack and container
EDITOR_SUBNET='172.31.250.0/24'     # Docker network; change it if another network uses it

# ---- Ready image or build from source -------------------------------------
# Default: the ready image (amd64 + arm64). Updates with: docker compose pull && docker compose up -d
IMAGE='ghcr.io/bottega-lab/homepage-editor:1'
# To build from the source in this folder instead, use the second line (and: docker compose up -d --build).
COMPOSE_FILE='docker-compose.yml'
#COMPOSE_FILE='docker-compose.yml:docker-compose.build.yml'

# Only for tools that keep their own copy of the compose file (e.g. Dockhand): the full path of
# this folder, so ./editor, ./backups and ./data are still found.
#APP_DIR='/opt/homepage-editor'
